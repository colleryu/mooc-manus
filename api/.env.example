ENV=development
LOG_LEVEL=INFO
APP_CONFIG_FILEPATH=config.yaml

SQLALCHEMY_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/manus
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=
COS_SCHEME=https
COS_BUCKET=
COS_DOMAIN=

# 留空 SANDBOX_ADDRESS 时，每个会话创建独立 Sandbox 容器。
# 仅在显式使用共享外部 Sandbox 时填写该地址。
SANDBOX_ADDRESS=
SANDBOX_IMAGE=sandbox-dev:latest
SANDBOX_NAME_PREFIX=mooc-manus-sandbox
SANDBOX_TTL_MINUTES=60
SANDBOX_NETWORK=
SANDBOX_CHROME_ARGS=
SANDBOX_HTTPS_PROXY=
SANDBOX_HTTP_PROXY=
SANDBOX_NO_PROXY=
